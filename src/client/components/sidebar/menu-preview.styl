.sidebar.sidebar-menu-preview
  display flex
  flex-direction column
  .preview-brand
    display flex
    align-items center
    justify-content space-between
    gap 6px
    flex-shrink 0
    height 64px
    padding 0 10px 0 14px
    border-bottom 1px solid var(--border)
    .menu-control
      display inline-flex
      align-items center
      gap 9px
      min-width 0
      flex 1
      padding 0
      border 0
      background transparent
      color var(--text)
      cursor pointer
      &:focus-visible
        outline 2px solid var(--primary)
        outline-offset 2px
    .menu-logo-a
      flex-shrink 0
      width 30px
      height 30px
      border-radius 8px
      object-fit cover
    .sidebar-brand-text
      display flex
      flex-direction column
      justify-content center
      min-width 0
      text-align left
      line-height 1.2
    .sidebar-brand-name
      font-size 14px
      line-height 18px
      font-weight 600
      color var(--text-light)
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
    .sidebar-brand-sub
      font-size 10px
      line-height 13px
      color var(--text-dark)
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
  .preview-navigation
    flex 1
    min-height 0
    overflow-y auto
    overflow-x hidden
    padding 8px 10px
    scrollbar-width thin
  .preview-group
    position relative
    & + .preview-group
      margin-top 8px
      padding-top 0
      border-top 0
    &[open]::before
      content ''
      position absolute
      left 22px
      top 44px
      bottom 4px
      border-left 1px solid var(--border)
      pointer-events none
    summary
      display flex
      align-items center
      gap 10px
      min-height 36px
      padding 8px 12px
      border-radius 8px
      list-style none
      color var(--text-dark)
      font-size 11px
      font-weight 700
      letter-spacing .07em
      line-height 16px
      text-transform uppercase
      cursor pointer
      &:hover
        background var(--main-light)
      &:focus-visible
        outline 2px solid var(--primary)
        outline-offset -2px
      &::-webkit-details-marker
        display none
      > svg:first-child
        color inherit
        flex-shrink 0
        width 20px
        height 20px
      .preview-chevron
        margin-left auto
        flex-shrink 0
        width 14px
        height 14px
        transform rotate(-90deg)
    &[open] .preview-chevron
      transform rotate(0)
  .preview-menu-item
    display flex
    align-items center
    gap 10px
    width calc(100% - 28px)
    min-height 40px
    margin 1px 0 1px 28px
    padding 10px 12px
    border 0
    border-radius 8px
    background transparent
    color var(--text-dark)
    font inherit
    font-size 14px
    line-height 20px
    text-align left
    cursor pointer
    > svg
      flex-shrink 0
      width 20px
      height 20px
      stroke-width 1.75
    &:hover
    &.active
      background var(--main-light)
      color var(--text)
    &.active
      font-weight 500
    &:focus-visible
      outline 2px solid var(--primary)
      outline-offset -2px
    &:disabled
      opacity .45
      cursor not-allowed
    .preview-label
      flex 1
      min-width 0
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
    .preview-item-text
      display flex
      flex-direction column
      justify-content center
      flex 1
      min-width 0
      white-space normal
      .preview-item-name
        overflow hidden
        text-overflow ellipsis
        white-space nowrap
        line-height 18px
      .preview-item-sub
        overflow hidden
        text-overflow ellipsis
        white-space nowrap
        color var(--text-dark)
        font-size 11px
        line-height 14px
    &.has-sub
      align-items center
    .preview-pro-tag
      flex-shrink 0
      margin-left auto
      padding 1px 6px
      border-radius 4px
      background var(--main-light)
      color var(--primary)
      font-size 9px
      font-weight 700
      letter-spacing .04em
      line-height 14px
      text-transform uppercase
    &.pro:hover
      .preview-pro-tag
        background var(--primary)
        color var(--main-dark)
  .preview-footer
    display flex
    flex-direction column
    align-items center
    gap 8px
    flex-shrink 0
    min-height 34px
    max-height 40%
    overflow-y auto
    overflow-x hidden
    padding 4px 10px
    border-top 1px solid var(--border)
    color var(--text-dark)
    font-size 10px
    &:empty
      display none
    .zoom-reset-icon
      color var(--primary)
    .upgrade-icon
      color var(--primary)
  .preview-account
    display flex
    align-items center
    gap 10px
    flex-shrink 0
    margin 6px 10px 10px
    padding 8px 10px
    border 1px solid var(--border)
    border-radius 10px
    background var(--main-dark)
    color var(--text)
    cursor pointer
    text-align left
    transition border-color .15s, background .15s
    &:hover
      border-color var(--primary)
      background var(--main-light)
    &:focus-visible
      outline 2px solid var(--primary)
      outline-offset 1px
    .preview-account-icon
      display inline-flex
      align-items center
      justify-content center
      flex-shrink 0
      width 30px
      height 30px
      border-radius 8px
      background var(--main-light)
      color var(--primary)
    .preview-account-text
      display flex
      flex-direction column
      min-width 0
      flex 1
      line-height 1.2
    .preview-account-name
      font-size 13px
      font-weight 600
      color var(--text-light)
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
    .preview-account-sub
      font-size 10px
      color var(--text-dark)
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
    .preview-account-chevron
      flex-shrink 0
      color var(--text-dark)
  &.preview-compact
    .preview-label
    .preview-chevron
    .preview-pro-tag
    .preview-account-text
    .preview-account-chevron
    .sidebar-brand-text
      display none
    .preview-brand
      padding 0 5px
      justify-content center
    .preview-account
      justify-content center
      margin 6px 5px 8px
      padding 6px
    .preview-navigation
      padding 10px 5px
    .preview-group[open]::before
      display none
    .preview-group summary
    .preview-menu-item
      justify-content center
      padding-left 0
      padding-right 0
    .preview-menu-item
      width 100%
      margin-left 0
    .preview-footer
      justify-content center
      padding 4px 5px
  &.collapsed
    .preview-brand
    .preview-navigation
    .preview-account
    .preview-footer
      display none
