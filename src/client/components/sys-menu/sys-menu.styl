.context-menu
  position: relative
  width 280px
  color var(--text)
  background var(--main)

.context-item
  -webkit-app-region no-drag
  position relative
  height 28px
  line-height 28px
  padding 0 16px
  &:hover
    background var(--main-light)
    color var(--text)
    cursor pointer
  &.disabled
    color var(--text-disabled)
    &:hover
      color var(--text-disabled)
      background transparent
      cursor not-allowed
  &.zoom-item
    height 36px
    line-height 36px
    &:hover
      background transparent

.context-sub-text
  position absolute
  right 16px
  top 0
  color var(--text)

.context-menu
  hr
    margin 0
    border none
    border-bottom 1px solid var(--border)
.sub-context-menu
  display none
  width 200px
  position absolute
  left 100%
  top 0
  background var(--main)
  border 1px solid var(--border)
  box-shadow 0px 0px 3px 3px var(--main-dark)
  max-height 300px
  overflow-y scroll
  color var(--text)
.with-sub-menu
  &:hover
    .sub-context-menu
      display block

.sub-context-menu-item
  cursor pointer
  padding 5px 16px
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  &:hover, &.active
    background-color var(--main-light)
    color var(--text)
.bookmarks-sub-context-menu
  width 380px
  padding 20px 10px 10px 20px

.menu-control
  width 28px
  height 28px
  border-radius 30px
  color var(--text)
  font-size 16px
  text-align center
  display inline-block
  line-height 28px
  cursor pointer
  color var(--text)

.menu-logo
  display inline-block
  width 28px
  height 28px
  vertical-align middle
  color var(--text-disabled)
  &:hover
    color var(--text)
  svg
    fill currentColor
    width 100%
    height 100%